generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  SUPPORT
  OWNER
  MANAGER
  CONTENT_EDITOR
  VIEWER
}

enum SchoolNetworkRole {
  OWNER
  ADMIN
  VIEWER
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

enum StationStatus {
  DRAFT
  PENDING_SETUP
  ACTIVE
  PAUSED
  SUSPENDED
  CANCELLED
}

enum LocationStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum ZoneStatus {
  ACTIVE
  PAUSED
  OFFLINE
}

enum ChannelStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum StreamServerType {
  SHOUTCAST_V2
  ICECAST_V2
}

enum AudioCodec {
  MP3
  AAC
}

enum SourceConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  ERROR
}

enum PlayoutEventType {
  WORKER_STARTED
  WORKER_STOPPED
  WORKER_HEARTBEAT
  SOURCE_CONNECTING
  SOURCE_CONNECTED
  SOURCE_DISCONNECTED
  SOURCE_ERROR
  TRACK_STARTED
  TRACK_FINISHED
  TRACK_FAILED
}

enum MediaType {
  MUSIC
  COMMERCIAL
  JINGLE
  ANNOUNCEMENT
  VOICEOVER
}

enum MediaStatus {
  UPLOADING
  READY
  PROCESSING
  REJECTED
  ARCHIVED
  DELETED
}

enum MediaLibraryType {
  RUVANAS_CATALOGUE
  ORGANISATION_PROMO
}

enum PromoAssetStatus {
  ACTIVE
  ARCHIVED
}

enum PromoVersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
}

enum PromoQcStatus {
  PENDING
  PASSED
  FAILED
}

enum PromoSourceType {
  UPLOAD
  LEGACY_IMPORT
  STUDIO
}

enum PromoProcessingJobType {
  PREVIEW
  TRANSCODE
  LOUDNESS_ANALYSIS
}

enum PromoProcessingJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ENDED
  ARCHIVED
}

enum CampaignPriority {
  LOW
  NORMAL
  HIGH
  VERY_HIGH
}

enum CampaignTargetType {
  ALL_LOCATIONS
  BRAND
  LOCATION_GROUP
  LOCATION
  ZONE
}

enum CampaignSchedulingMode {
  PLAYS_PER_HOUR
  INTERVAL
  EXACT_TIMES
  ADVANCED_DAYPART
  SMART_PRIORITY
}

enum CampaignWindowMode {
  PLAYS_PER_HOUR
  INTERVAL
  EXACT_TIME
}

enum PlayerStatus {
  PENDING_ENROLMENT
  ONLINE
  OFFLINE
  DISABLED
}

enum TrackStatus {
  DRAFT
  READY
  ARCHIVED
}

enum MusicModeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MusicScheduleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProofOfPlayEventType {
  STARTED
  COMPLETED
  FAILED
  INTERRUPTED
}

enum PlaybackItemType {
  MUSIC
  PROMO
  SCHOOL_ANNOUNCEMENT
}

enum SchoolPublishingPolicy {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum SchoolAnnouncementStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  ARCHIVED
}

enum SchoolBroadcastSlotStatus {
  APPROVED
  CANCELLED
  COMPLETED
}

enum SchoolProgrammeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SchoolEpisodeStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  ARCHIVED
}

enum SchoolRundownStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  ARCHIVED
}

enum SchoolRundownItemType {
  MUSIC_TRACK
  JINGLE
  VOICE_TRACK
  INTERVIEW
  ANNOUNCEMENT
  SCRIPT_NOTE
  HARD_TIME
  FLEXIBLE_MARKER
}

enum SchoolPublicationScope {
  INTERNAL_ONLY
  PUBLIC
}

enum StudentContributorStatus {
  ACTIVE
  INACTIVE
}

enum SchoolSubmissionStatus {
  SUBMITTED
  SUPERSEDED
  WITHDRAWN
}

enum AssignmentStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum AssignmentSubmissionStatus {
  SUBMITTED
  REVISION_REQUESTED
  ASSESSED
  WITHDRAWN
}

enum AssessmentStatus {
  DRAFT
  RELEASED
}

enum PortfolioEntryStatus {
  PRIVATE
  ARCHIVED
}

enum SchoolModerationDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum ConsentRecordStatus {
  PENDING
  GRANTED
  REVOKED
  EXPIRED
}

enum AudioProjectType {
  QUICK_RECORD
  VOICE_TRACK
  MULTITRACK
}

enum AudioProjectStatus {
  DRAFT
  RECORDING
  UPLOADING
  READY
  SUBMITTED
  ARCHIVED
}

enum AudioTakeStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum AudioUploadStatus {
  INITIATED
  UPLOADING
  COMPLETING
  COMPLETED
  ABORTED
  FAILED
  EXPIRED
}

enum AudioWaveformStatus {
  PENDING
  RUNNING
  READY
  FAILED
}

enum AudioTrackKind {
  VOICE
  MUSIC
  EFFECT
  MIXED
}

enum AudioClipKind {
  SOURCE
  SILENCE
}

enum AudioMarkerType {
  INTRO
  INTERVIEW
  AD_PSA
  CHAPTER
  EDIT_NOTE
  TEACHER_FEEDBACK
}

enum AudioRenderPreset {
  SCHOOL_RADIO_MP3
  SPEECH_MP3
  WAV_MASTER
}

enum AudioRenderStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum SchoolPodcastStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum TranscriptStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
}

enum SchoolNewsStoryType {
  NEWS_BULLETIN
  INTERVIEW
  SPORTS_RESULT
  SCHOOL_NOTICE
  FEATURE_STORY
}

enum SchoolNewsStoryStatus {
  PITCH
  ASSIGNED
  SCRIPTING
  FACT_CHECK
  AUDIO_PRODUCTION
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum LiveStudioStatus {
  CREATED
  SOUNDCHECK
  READY
  ON_AIR
  FALLBACK
  ENDED
}

enum LiveConnectionQuality {
  UNKNOWN
  GOOD
  DEGRADED
  FAILED
}

enum ReportExportStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
  EXPIRED
}

enum ProductionOrderStatus {
  DRAFT
  SUBMITTED
  IN_PRODUCTION
  AWAITING_CUSTOMER_APPROVAL
  CHANGES_REQUESTED
  APPROVED
  DELIVERED
  CANCELLED
}

enum ProductionOrderPriority {
  STANDARD
  PRIORITY
  URGENT
}

enum ProductionFundingType {
  PLAN_INCLUDED
  PAID_ADD_ON
}

enum ProductionFundingStatus {
  LEGACY_UNMETERED
  PENDING
  RESERVED
  CONSUMED
  RELEASED
}

enum ProductionCreditEntryType {
  GRANT
  PURCHASE
  RESERVE
  CONSUME
  RELEASE
  EXPIRY
  ADJUSTMENT
}

enum ProductionOrderEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNMENT_CHANGED
  FILE_ADDED
  SCRIPT_VERSION_CREATED
  REVISION_REQUESTED
  REVISION_RESOLVED
  FUNDING_CHANGED
  PROMO_HANDOFF_CREATED
}

enum ProductionOrderFileKind {
  BRIEF_ATTACHMENT
  AUDIO_PREVIEW
  FINAL_MASTER
}

enum ProductionRevisionStatus {
  OPEN
  RESOLVED
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships                   OrganisationMember[]
  auditLogs                     AuditLog[]                    @relation("AuditActor")
  sessions                      Session[]
  submittedPromoVersions        PromoVersion[]                @relation("PromoVersionSubmittedBy")
  reviewedPromoVersions         PromoVersion[]                @relation("PromoVersionReviewedBy")
  publishedCampaigns            Campaign[]                    @relation("CampaignPublishedBy")
  reportExports                 ReportExportJob[]             @relation("ReportExportRequestedBy")
  confirmedTrackRights          Track[]                       @relation("TrackRightsConfirmedBy")
  createdSchoolAnnouncements    SchoolAnnouncement[]          @relation("SchoolAnnouncementCreatedBy")
  reviewedSchoolAnnouncements   SchoolAnnouncement[]          @relation("SchoolAnnouncementReviewedBy")
  approvedSchoolSlots           SchoolBroadcastSlot[]         @relation("SchoolBroadcastSlotApprovedBy")
  createdProductionOrders       ProductionOrder[]             @relation("ProductionOrderCreatedBy")
  assignedProductionOrders      ProductionOrder[]             @relation("ProductionOrderAssignedTo")
  productionOrderEvents         ProductionOrderEvent[]        @relation("ProductionOrderEventActor")
  productionOrderFiles          ProductionOrderFile[]         @relation("ProductionOrderFileUploadedBy")
  productionScriptVersions      ProductionScriptVersion[]     @relation("ProductionScriptVersionCreatedBy")
  requestedProductionRevisions  ProductionRevisionRequest[]   @relation("ProductionRevisionRequestedBy")
  resolvedProductionRevisions   ProductionRevisionRequest[]   @relation("ProductionRevisionResolvedBy")
  productionCreditEntries       ProductionCreditLedgerEntry[] @relation("ProductionCreditEntryActor")
  schoolSupervisions            StaffSupervisor[]             @relation("SchoolSupervisorUser")
  createdStudentGroups          StudentGroup[]                @relation("StudentGroupCreatedBy")
  createdSchoolProgrammes       SchoolProgramme[]             @relation("SchoolProgrammeCreatedBy")
  createdSchoolEpisodes         SchoolEpisode[]               @relation("SchoolEpisodeCreatedBy")
  schoolSubmissions             SchoolSubmission[]            @relation("SchoolSubmissionSubmittedBy")
  schoolModerationReviews       SchoolModerationReview[]      @relation("SchoolModerationReviewer")
  recordedConsentRecords        ConsentRecord[]               @relation("ConsentRecordedBy")
  createdAudioProjects          AudioProject[]                @relation("AudioProjectCreatedBy")
  audioProjectVersions          AudioProjectVersion[]         @relation("AudioProjectVersionCreatedBy")
  recordedAudioTakes            AudioTake[]                   @relation("AudioTakeRecordedBy")
  schoolAudioUploads            SchoolAudioUploadSession[]    @relation("SchoolAudioUploadCreatedBy")
  createdAudioMarkers           AudioMarker[]                 @relation("AudioMarkerCreatedBy")
  requestedAudioRenders         AudioRender[]                 @relation("AudioRenderRequestedBy")
  createdSchoolRundowns         SchoolRundown[]               @relation("SchoolRundownCreatedBy")
  reviewedSchoolRundowns        SchoolRundown[]               @relation("SchoolRundownReviewedBy")
  createdPodcastSeries          SchoolPodcastSeries[]         @relation("SchoolPodcastSeriesCreatedBy")
  createdPodcastEpisodes        SchoolPodcastEpisode[]        @relation("SchoolPodcastEpisodeCreatedBy")
  reviewedPodcastEpisodes       SchoolPodcastEpisode[]        @relation("SchoolPodcastEpisodeReviewedBy")
  createdNewsStories            SchoolNewsStory[]             @relation("SchoolNewsStoryCreatedBy")
  assignedNewsStories           SchoolNewsStory[]             @relation("SchoolNewsStoryAssignedTo")
  reviewedNewsStories           SchoolNewsStory[]             @relation("SchoolNewsStoryReviewedBy")
  supervisedLiveSessions        LiveStudioSession[]           @relation("LiveStudioSupervisor")
  createdAssignments            Assignment[]                  @relation("AssignmentCreatedBy")
  recordedAssignmentSubmissions AssignmentSubmission[]        @relation("AssignmentSubmissionRecordedBy")
  assignmentAssessments         Assessment[]                  @relation("AssessmentAssessedBy")
  createdPortfolioEntries       PortfolioEntry[]              @relation("PortfolioEntryCreatedBy")
  createdSchoolNetworks         SchoolNetwork[]               @relation("SchoolNetworkCreatedBy")
  schoolNetworkMemberships      SchoolNetworkMember[]
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                    OrganisationMember[]
  subscription               Subscription?
  stations                   Station[]
  brands                     Brand[]
  locations                  Location[]
  locationGroups             LocationGroup[]
  channels                   Channel[]
  mediaAssets                MediaAsset[]                  @relation("OrganisationMediaAssets")
  promoAssets                PromoAsset[]
  auditLogs                  AuditLog[]
  players                    Player[]
  musicModes                 MusicMode[]
  musicSchedules             MusicSchedule[]
  proofOfPlayEvents          ProofOfPlayEvent[]
  campaigns                  Campaign[]
  playoutIntents             PlayoutIntent[]
  reportExports              ReportExportJob[]
  activeSessions             Session[]
  schoolProfile              SchoolProfile?
  schoolAnnouncements        SchoolAnnouncement[]
  schoolBroadcastSlots       SchoolBroadcastSlot[]
  productionOrders           ProductionOrder[]
  productionOrderEvents      ProductionOrderEvent[]
  productionOrderFiles       ProductionOrderFile[]
  productionScriptVersions   ProductionScriptVersion[]
  productionRevisionRequests ProductionRevisionRequest[]
  productionCreditEntries    ProductionCreditLedgerEntry[]
  staffSupervisors           StaffSupervisor[]
  studentGroups              StudentGroup[]
  studentContributors        StudentContributor[]
  schoolProgrammes           SchoolProgramme[]
  schoolEpisodes             SchoolEpisode[]
  schoolSubmissions          SchoolSubmission[]
  schoolModerationReviews    SchoolModerationReview[]
  consentRecords             ConsentRecord[]
  audioProjects              AudioProject[]
  audioTakes                 AudioTake[]
  schoolAudioUploads         SchoolAudioUploadSession[]
  audioRenders               AudioRender[]
  schoolRundowns             SchoolRundown[]
  schoolPodcastSeries        SchoolPodcastSeries[]
  schoolPodcastEpisodes      SchoolPodcastEpisode[]
  transcripts                Transcript[]
  schoolNewsStories          SchoolNewsStory[]
  liveStudioSessions         LiveStudioSession[]
  assignments                Assignment[]
  assignmentSubmissions      AssignmentSubmission[]
  assessments                Assessment[]
  portfolioEntries           PortfolioEntry[]
  schoolNetworkSchool        SchoolNetworkSchool?
}

model OrganisationMember {
  id             String   @id @default(cuid())
  userId         String
  organisationId String
  role           UserRole @default(OWNER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@index([organisationId])
}

model SchoolNetwork {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User                  @relation("SchoolNetworkCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  members   SchoolNetworkMember[]
  schools   SchoolNetworkSchool[]
  auditLogs AuditLog[]

  @@index([createdByUserId])
}

model SchoolNetworkMember {
  id              String            @id @default(cuid())
  schoolNetworkId String
  userId          String
  role            SchoolNetworkRole @default(VIEWER)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  schoolNetwork SchoolNetwork @relation(fields: [schoolNetworkId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolNetworkId, userId])
  @@index([userId])
  @@index([schoolNetworkId, role])
}

model SchoolNetworkSchool {
  id              String   @id @default(cuid())
  schoolNetworkId String
  organisationId  String   @unique
  active          Boolean  @default(true)
  joinedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  schoolNetwork SchoolNetwork @relation(fields: [schoolNetworkId], references: [id], onDelete: Cascade)
  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([schoolNetworkId, organisationId])
  @@index([schoolNetworkId, active])
}

model Plan {
  id                       String   @id @default(cuid())
  name                     String   @unique
  code                     String   @unique
  monthlyPriceCents        Int
  stationLimit             Int      @default(1)
  storageLimitGb           Int
  listenerLimit            Int
  maxBitrateKbps           Int
  includesRuvanasCatalogue Boolean  @default(false)
  promoUploadEnabled       Boolean  @default(true)
  schoolRadioEnabled       Boolean  @default(false)
  active                   Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(cuid())
  organisationId     String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  currentPeriodEnd   DateTime?
  schoolRadioEnabled Boolean?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
}

model Brand {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  slug           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation    Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  locations       Location[]
  channels        Channel[]
  campaignTargets CampaignTarget[]

  @@unique([organisationId, slug])
  @@index([organisationId])
}

model Location {
  id             String         @id @default(cuid())
  organisationId String
  brandId        String?
  name           String
  slug           String
  status         LocationStatus @default(DRAFT)
  timezone       String         @default("Europe/Malta")
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  postalCode     String?
  countryCode    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organisation         Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand                Brand?                     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  zones                Zone[]
  groupMemberships     LocationGroupMember[]
  openingHours         LocationOpeningHour[]
  openingExceptions    LocationOpeningException[]
  musicSchedules       MusicSchedule[]
  campaignTargets      CampaignTarget[]
  schoolBroadcastSlots SchoolBroadcastSlot[]

  @@unique([organisationId, slug])
  @@index([organisationId])
  @@index([brandId])
}

model LocationOpeningHour {
  id             String   @id @default(cuid())
  locationId     String
  weekday        Int
  isClosed       Boolean  @default(false)
  opensAtMinute  Int?
  closesAtMinute Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, weekday])
  @@index([locationId])
}

model LocationOpeningException {
  id             String   @id @default(cuid())
  locationId     String
  date           DateTime @db.Date
  isClosed       Boolean  @default(true)
  opensAtMinute  Int?
  closesAtMinute Int?
  label          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, date])
  @@index([locationId, date])
}

model LocationGroup {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  slug           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation    Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  locations       LocationGroupMember[]
  campaignTargets CampaignTarget[]

  @@unique([organisationId, slug])
  @@index([organisationId])
}

model LocationGroupMember {
  locationGroupId String
  locationId      String
  createdAt       DateTime @default(now())

  locationGroup LocationGroup @relation(fields: [locationGroupId], references: [id], onDelete: Cascade)
  location      Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([locationGroupId, locationId])
  @@index([locationId])
}

model Zone {
  id         String     @id @default(cuid())
  locationId String
  name       String
  slug       String
  status     ZoneStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  location             Location              @relation(fields: [locationId], references: [id], onDelete: Cascade)
  channelAssignments   ChannelAssignment[]
  players              Player[]
  musicSchedules       MusicSchedule[]
  proofOfPlayEvents    ProofOfPlayEvent[]
  campaignTargets      CampaignTarget[]
  playoutIntents       PlayoutIntent[]
  schoolBroadcastSlots SchoolBroadcastSlot[]

  @@unique([locationId, slug])
  @@index([locationId])
}

model Channel {
  id             String        @id @default(cuid())
  organisationId String
  brandId        String?
  stationId      String?
  name           String
  slug           String
  description    String?
  status         ChannelStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation       Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand              Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  station            Station?            @relation(fields: [stationId], references: [id], onDelete: SetNull)
  zoneAssignments    ChannelAssignment[]
  playoutEvents      PlayoutEvent[]
  playoutIntents     PlayoutIntent[]
  proofOfPlayEvents  ProofOfPlayEvent[]
  liveStudioSessions LiveStudioSession[]

  @@unique([organisationId, slug])
  @@index([organisationId])
  @@index([brandId])
  @@index([stationId])
}

model ChannelAssignment {
  id         String    @id @default(cuid())
  channelId  String
  zoneId     String
  activeFrom DateTime  @default(now())
  activeTo   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  zone    Zone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([channelId, zoneId])
  @@index([zoneId])
}

model Station {
  id                String        @id @default(cuid())
  organisationId    String
  name              String
  slug              String        @unique
  description       String?
  logoUrl           String?
  status            StationStatus @default(DRAFT)
  storageUsedMb     Int           @default(0)
  listenerLimit     Int
  storageLimitGb    Int
  maxBitrateKbps    Int
  providerName      String?
  providerAccountId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organisation  Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  streamConfig  StationStreamConfig?
  channels      Channel[]
  playoutEvents PlayoutEvent[]

  @@index([organisationId])
}

model StationStreamConfig {
  id        String @id @default(cuid())
  stationId String @unique

  centovaUsername String?
  streamUrl       String?
  mountPoint      String?
  serverHost      String?
  serverPort      Int?
  bitrateKbps     Int?

  serverType     StreamServerType @default(SHOUTCAST_V2)
  outputCodec    AudioCodec       @default(MP3)
  sampleRateHz   Int              @default(44100)
  outputChannels Int              @default(2)

  sourceConnectionStatus SourceConnectionStatus @default(DISCONNECTED)
  lastConnectedAt        DateTime?
  lastHeartbeatAt        DateTime?
  lastError              String?

  adminPasswordEncrypted  String?
  sourcePasswordEncrypted String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)
}

model PlayoutEvent {
  id         String           @id @default(cuid())
  channelId  String
  stationId  String
  eventType  PlayoutEventType
  assetId    String?
  message    String?
  metadata   Json?
  occurredAt DateTime         @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([channelId, occurredAt])
  @@index([stationId, occurredAt])
  @@index([eventType, occurredAt])
}

model MediaAsset {
  id              String           @id @default(cuid())
  organisationId  String?
  libraryType     MediaLibraryType @default(ORGANISATION_PROMO)
  name            String
  originalName    String
  storageKey      String           @unique
  mimeType        String
  sizeBytes       BigInt
  durationSeconds Int?
  mediaType       MediaType
  status          MediaStatus      @default(UPLOADING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organisation       Organisation?       @relation("OrganisationMediaAssets", fields: [organisationId], references: [id], onDelete: Cascade)
  genres             MediaAssetGenre[]
  track              Track?
  promoVersions      PromoVersion[]
  audioTakes         AudioTake[]
  audioClips         AudioClip[]
  audioRenderOutputs AudioRender[]       @relation("AudioRenderOutput")
  proofOfPlayEvents  ProofOfPlayEvent[]
  playoutIntents     PlayoutIntent[]
  schoolRundownItems SchoolRundownItem[]
  transcripts        Transcript[]
  interviewStories   SchoolNewsStory[]   @relation("SchoolNewsInterviewAsset")
  liveRecordings     LiveStudioSession[] @relation("LiveStudioRecordingAsset")

  @@index([organisationId])
  @@index([libraryType])
  @@index([organisationId, libraryType])
  @@index([organisationId, mediaType])
  @@index([organisationId, status])
  @@index([libraryType, status])
}

model PromoAsset {
