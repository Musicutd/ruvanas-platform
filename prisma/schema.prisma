model OrganisationMember {
  id             String   @id @default(cuid())
  userId         String
  organisationId String
  role           UserRole @default(OWNER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@index([organisationId])
}

model SchoolNetwork {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy             User                         @relation("SchoolNetworkCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  members               SchoolNetworkMember[]
  schools               SchoolNetworkSchool[]
  episodeExchangeOffers SchoolEpisodeExchangeOffer[]
  auditLogs             AuditLog[]

  @@index([createdByUserId])
}

