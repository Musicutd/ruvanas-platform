generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  SUPPORT
  OWNER
  MANAGER
  CONTENT_EDITOR
  VIEWER
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

enum StationStatus {
  DRAFT
  PENDING_SETUP
  ACTIVE
  PAUSED
  SUSPENDED
  CANCELLED
}

enum LocationStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum ZoneStatus {
  ACTIVE
  PAUSED
  OFFLINE
}

enum ChannelStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MediaType {
  MUSIC
  COMMERCIAL
  JINGLE
  ANNOUNCEMENT
  VOICEOVER
}

enum MediaStatus {
  UPLOADING
  READY
  PROCESSING
  REJECTED
  ARCHIVED
  DELETED
}

enum MediaLibraryType {
  RUVANAS_CATALOGUE
  ORGANISATION_PROMO
}

model User {
  id           String               @id @default(cuid())
  name         String?
  email        String               @unique
  passwordHash String
  role         UserRole             @default(OWNER)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  memberships  OrganisationMember[]
  auditLogs    AuditLog[]           @relation("AuditActor")
  sessions     Session[]
}

model Organisation {
  id              String               @id @default(cuid())
  name            String
  slug            String               @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  members         OrganisationMember[]
  subscription    Subscription?
  stations        Station[]
  brands          Brand[]
  locations       Location[]
  channels        Channel[]
  mediaAssets     MediaAsset[]        @relation("OrganisationMediaAssets")
  auditLogs       AuditLog[]
}

model OrganisationMember {
  id             String   @id @default(cuid())
  userId         String
  organisationId String
  role           UserRole @default(OWNER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@index([organisationId])
}

model Plan {
  id                       String         @id @default(cuid())
  name                     String         @unique
  code                     String         @unique
  monthlyPriceCents        Int
  stationLimit             Int            @default(1)
  storageLimitGb           Int
  listenerLimit            Int
  maxBitrateKbps           Int
  includesRuvanasCatalogue Boolean        @default(false)
  promoUploadEnabled       Boolean        @default(true)
  active                   Boolean        @default(true)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  subscriptions            Subscription[]
}

model Subscription {
  id               String             @id @default(cuid())
  organisationId   String             @unique
  planId           String
  status           SubscriptionStatus @default(TRIAL)
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
}

model Brand {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  slug           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  locations    Location[]
  channels     Channel[]

  @@unique([organisationId, slug])
  @@index([organisationId])
}

model Location {
  id             String         @id @default(cuid())
  organisationId String
  brandId        String?
  name           String
  slug           String
  status         LocationStatus @default(DRAFT)
  timezone       String         @default("Europe/Malta")
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  postalCode     String?
  countryCode    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand        Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  zones        Zone[]

  @@unique([organisationId, slug])
  @@index([organisationId])
  @@index([brandId])
}

model Zone {
  id                 String              @id @default(cuid())
  locationId         String
  name               String
  slug               String
  status             ZoneStatus          @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  location           Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  channelAssignments ChannelAssignment[]

  @@unique([locationId, slug])
  @@index([locationId])
}

model Channel {
  id              String         @id @default(cuid())
  organisationId  String
  brandId         String?
  stationId       String?
  name            String
  slug            String
  description     String?
  status          ChannelStatus  @default(DRAFT)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organisation    Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand           Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  station         Station?            @relation(fields: [stationId], references: [id], onDelete: SetNull)
  zoneAssignments ChannelAssignment[]

  @@unique([organisationId, slug])
  @@index([organisationId])
  @@index([brandId])
  @@index([stationId])
}

model ChannelAssignment {
  id         String   @id @default(cuid())
  channelId  String
  zoneId     String
  activeFrom DateTime @default(now())
  activeTo   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  zone    Zone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([channelId, zoneId])
  @@index([zoneId])
}

model Station {
  id                String        @id @default(cuid())
  organisationId    String
  name              String
  slug              String        @unique
  description       String?
  logoUrl           String?
  status            StationStatus @default(DRAFT)
  storageUsedMb     Int           @default(0)
  listenerLimit     Int
  storageLimitGb    Int
  maxBitrateKbps    Int
  providerName      String?
  providerAccountId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organisation Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  streamConfig StationStreamConfig?
  channels     Channel[]

  @@index([organisationId])
}

model StationStreamConfig {
  id                      String   @id @default(cuid())
  stationId               String   @unique
  centovaUsername         String?
  streamUrl               String?
  mountPoint              String?
  serverHost              String?
  serverPort              Int?
  bitrateKbps             Int?
  adminPasswordEncrypted  String?
  sourcePasswordEncrypted String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)
}

model MediaAsset {
  id              String           @id @default(cuid())
  organisationId  String?
  libraryType     MediaLibraryType @default(ORGANISATION_PROMO)
  name            String
  originalName    String
  storageKey      String           @unique
  mimeType        String
  sizeBytes       BigInt
  durationSeconds Int?
  mediaType       MediaType
  status          MediaStatus      @default(UPLOADING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organisation Organisation?      @relation("OrganisationMediaAssets", fields: [organisationId], references: [id], onDelete: Cascade)
  genres       MediaAssetGenre[]

  @@index([organisationId])
  @@index([libraryType])
  @@index([organisationId, libraryType])
  @@index([organisationId, mediaType])
  @@index([organisationId, status])
  @@index([libraryType, status])
}

model MediaGenre {
  id        String            @id @default(cuid())
  name      String            @unique
  slug      String            @unique
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  mediaAssets MediaAssetGenre[]
}

model MediaAssetGenre {
  mediaAssetId String
  mediaGenreId String
  isPrimary    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  mediaGenre MediaGenre @relation(fields: [mediaGenreId], references: [id], onDelete: Cascade)

  @@id([mediaAssetId, mediaGenreId])
  @@index([mediaGenreId])
  @@index([mediaAssetId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organisationId String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  details        Json?
  createdAt      DateTime @default(now())

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([actorUserId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
