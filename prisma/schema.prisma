generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  SUPPORT
  OWNER
  MANAGER
  CONTENT_EDITOR
  VIEWER
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

enum StationStatus {
  DRAFT
  PENDING_SETUP
  ACTIVE
  PAUSED
  SUSPENDED
  CANCELLED
}

enum LocationStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum ZoneStatus {
  ACTIVE
  PAUSED
  OFFLINE
}

enum ChannelStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum StreamServerType {
  SHOUTCAST_V2
  ICECAST_V2
}

enum AudioCodec {
  MP3
  AAC
}

enum SourceConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  ERROR
}

enum PlayoutEventType {
  WORKER_STARTED
  WORKER_STOPPED
  WORKER_HEARTBEAT
  SOURCE_CONNECTING
  SOURCE_CONNECTED
  SOURCE_DISCONNECTED
  SOURCE_ERROR
  TRACK_STARTED
  TRACK_FINISHED
  TRACK_FAILED
}

enum MediaType {
  MUSIC
  COMMERCIAL
  JINGLE
  ANNOUNCEMENT
  VOICEOVER
}

enum MediaStatus {
  UPLOADING
  READY
  PROCESSING
  REJECTED
  ARCHIVED
  DELETED
}

enum MediaLibraryType {
  RUVANAS_CATALOGUE
  ORGANISATION_PROMO
}

enum PromoAssetStatus {
  ACTIVE
  ARCHIVED
}

enum PromoVersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
}

enum PromoQcStatus {
  PENDING
  PASSED
  FAILED
}

enum PromoSourceType {
  UPLOAD
  LEGACY_IMPORT
  STUDIO
}

enum PromoProcessingJobType {
  PREVIEW
  TRANSCODE
  LOUDNESS_ANALYSIS
}

enum PromoProcessingJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ENDED
  ARCHIVED
}

enum CampaignPriority {
  LOW
  NORMAL
  HIGH
  VERY_HIGH
}

enum CampaignTargetType {
  ALL_LOCATIONS
  BRAND
  LOCATION_GROUP
  LOCATION
  ZONE
}

enum CampaignSchedulingMode {
  PLAYS_PER_HOUR
  INTERVAL
  EXACT_TIMES
  ADVANCED_DAYPART
  SMART_PRIORITY
}

enum CampaignWindowMode {
  PLAYS_PER_HOUR
  INTERVAL
  EXACT_TIME
}

enum PlayerStatus {
  PENDING_ENROLMENT
  ONLINE
  OFFLINE
  DISABLED
}

enum TrackStatus {
  DRAFT
  READY
  ARCHIVED
}

enum MusicModeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MusicScheduleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProofOfPlayEventType {
  STARTED
  COMPLETED
  FAILED
  INTERRUPTED
}

enum PlaybackItemType {
  MUSIC
  PROMO
}

enum ReportExportStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
  EXPIRED
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships            OrganisationMember[]
  auditLogs              AuditLog[]           @relation("AuditActor")
  sessions               Session[]
  submittedPromoVersions PromoVersion[]       @relation("PromoVersionSubmittedBy")
  reviewedPromoVersions  PromoVersion[]       @relation("PromoVersionReviewedBy")
  publishedCampaigns     Campaign[]           @relation("CampaignPublishedBy")
  reportExports          ReportExportJob[]    @relation("ReportExportRequestedBy")
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members           OrganisationMember[]
  subscription      Subscription?
  stations          Station[]
  brands            Brand[]
  locations         Location[]
  locationGroups    LocationGroup[]
  channels          Channel[]
  mediaAssets       MediaAsset[]         @relation("OrganisationMediaAssets")
  promoAssets       PromoAsset[]
  auditLogs         AuditLog[]
  players           Player[]
  musicModes        MusicMode[]
  musicSchedules    MusicSchedule[]
  proofOfPlayEvents ProofOfPlayEvent[]
  campaigns         Campaign[]
  playoutIntents    PlayoutIntent[]
  reportExports     ReportExportJob[]
  activeSessions    Session[]
}

model OrganisationMember {
  id             String   @id @default(cuid())
  userId         String
  organisationId String
  role           UserRole @default(OWNER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@index([organisationId])
}

model Plan {
  id                       String   @id @default(cuid())
  name                     String   @unique
  code                     String   @unique
  monthlyPriceCents        Int
  stationLimit             Int      @default(1)
  storageLimitGb           Int
  listenerLimit            Int
  maxBitrateKbps           Int
  includesRuvanasCatalogue Boolean  @default(false)
  promoUploadEnabled       Boolean  @default(true)
  active                   Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id               String             @id @default(cuid())
  organisationId   String             @unique
  planId           String
  status           SubscriptionStatus @default(TRIAL)
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
}

model Brand {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  slug           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation    Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  locations       Location[]
  channels        Channel[]
  campaignTargets CampaignTarget[]

  @@unique([organisationId, slug])
  @@index([organisationId])
}

model Location {
  id             String         @id @default(cuid())
  organisationId String
  brandId        String?
  name           String
  slug           String
  status         LocationStatus @default(DRAFT)
  timezone       String         @default("Europe/Malta")
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  postalCode     String?
  countryCode    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organisation      Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand             Brand?                     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  zones             Zone[]
  groupMemberships  LocationGroupMember[]
  openingHours      LocationOpeningHour[]
  openingExceptions LocationOpeningException[]
  musicSchedules    MusicSchedule[]
  campaignTargets   CampaignTarget[]

  @@unique([organisationId, slug])
  @@index([organisationId])
  @@index([brandId])
}

model LocationOpeningHour {
  id             String   @id @default(cuid())
  locationId     String
  weekday        Int
  isClosed       Boolean  @default(false)
  opensAtMinute  Int?
  closesAtMinute Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, weekday])
  @@index([locationId])
}

model LocationOpeningException {
  id             String   @id @default(cuid())
  locationId     String
  date           DateTime @db.Date
  isClosed       Boolean  @default(true)
  opensAtMinute  Int?
  closesAtMinute Int?
  label          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, date])
  @@index([locationId, date])
}

model LocationGroup {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  slug           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation    Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  locations       LocationGroupMember[]
  campaignTargets CampaignTarget[]

  @@unique([organisationId, slug])
  @@index([organisationId])
}

model LocationGroupMember {
  locationGroupId String
  locationId      String
  createdAt       DateTime @default(now())

  locationGroup LocationGroup @relation(fields: [locationGroupId], references: [id], onDelete: Cascade)
  location      Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([locationGroupId, locationId])
  @@index([locationId])
}

model Zone {
  id         String     @id @default(cuid())
  locationId String
  name       String
  slug       String
  status     ZoneStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  location           Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  channelAssignments ChannelAssignment[]
  players            Player[]
  musicSchedules     MusicSchedule[]
  proofOfPlayEvents  ProofOfPlayEvent[]
  campaignTargets    CampaignTarget[]
  playoutIntents     PlayoutIntent[]

  @@unique([locationId, slug])
  @@index([locationId])
}

model Channel {
  id             String        @id @default(cuid())
  organisationId String
  brandId        String?
  stationId      String?
  name           String
  slug           String
  description    String?
  status         ChannelStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation      Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand             Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  station           Station?            @relation(fields: [stationId], references: [id], onDelete: SetNull)
  zoneAssignments   ChannelAssignment[]
  playoutEvents     PlayoutEvent[]
  playoutIntents    PlayoutIntent[]
  proofOfPlayEvents ProofOfPlayEvent[]

  @@unique([organisationId, slug])
  @@index([organisationId])
  @@index([brandId])
  @@index([stationId])
}

model ChannelAssignment {
  id         String    @id @default(cuid())
  channelId  String
  zoneId     String
  activeFrom DateTime  @default(now())
  activeTo   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  zone    Zone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([channelId, zoneId])
  @@index([zoneId])
}

model Station {
  id                String        @id @default(cuid())
  organisationId    String
  name              String
  slug              String        @unique
  description       String?
  logoUrl           String?
  status            StationStatus @default(DRAFT)
  storageUsedMb     Int           @default(0)
  listenerLimit     Int
  storageLimitGb    Int
  maxBitrateKbps    Int
  providerName      String?
  providerAccountId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organisation  Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  streamConfig  StationStreamConfig?
  channels      Channel[]
  playoutEvents PlayoutEvent[]

  @@index([organisationId])
}

model StationStreamConfig {
  id        String @id @default(cuid())
  stationId String @unique

  centovaUsername String?
  streamUrl       String?
  mountPoint      String?
  serverHost      String?
  serverPort      Int?
  bitrateKbps     Int?

  serverType     StreamServerType @default(SHOUTCAST_V2)
  outputCodec    AudioCodec       @default(MP3)
  sampleRateHz   Int              @default(44100)
  outputChannels Int              @default(2)

  sourceConnectionStatus SourceConnectionStatus @default(DISCONNECTED)
  lastConnectedAt        DateTime?
  lastHeartbeatAt        DateTime?
  lastError              String?

  adminPasswordEncrypted  String?
  sourcePasswordEncrypted String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)
}

model PlayoutEvent {
  id         String           @id @default(cuid())
  channelId  String
  stationId  String
  eventType  PlayoutEventType
  assetId    String?
  message    String?
  metadata   Json?
  occurredAt DateTime         @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([channelId, occurredAt])
  @@index([stationId, occurredAt])
  @@index([eventType, occurredAt])
}

model MediaAsset {
  id              String           @id @default(cuid())
  organisationId  String?
  libraryType     MediaLibraryType @default(ORGANISATION_PROMO)
  name            String
  originalName    String
  storageKey      String           @unique
  mimeType        String
  sizeBytes       BigInt
  durationSeconds Int?
  mediaType       MediaType
  status          MediaStatus      @default(UPLOADING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organisation      Organisation?      @relation("OrganisationMediaAssets", fields: [organisationId], references: [id], onDelete: Cascade)
  genres            MediaAssetGenre[]
  track             Track?
  promoVersions     PromoVersion[]
  proofOfPlayEvents ProofOfPlayEvent[]
  playoutIntents    PlayoutIntent[]

  @@index([organisationId])
  @@index([libraryType])
  @@index([organisationId, libraryType])
  @@index([organisationId, mediaType])
  @@index([organisationId, status])
  @@index([libraryType, status])
}

model PromoAsset {
  id                       String           @id @default(cuid())
  organisationId           String
  name                     String
  mediaType                MediaType
  languageCode             String           @default("und")
  status                   PromoAssetStatus @default(ACTIVE)
  currentApprovedVersionId String?          @unique
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  organisation           Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  versions               PromoVersion[] @relation("PromoAssetVersions")
  currentApprovedVersion PromoVersion?  @relation("CurrentApprovedPromoVersion", fields: [currentApprovedVersionId], references: [id], onDelete: SetNull)

  @@index([organisationId, status])
  @@index([organisationId, name])
}

model PromoVersion {
  id              String             @id @default(cuid())
  promoAssetId    String
  mediaAssetId    String
  version         Int
  status          PromoVersionStatus @default(DRAFT)
  qcStatus        PromoQcStatus      @default(PENDING)
  sourceType      PromoSourceType    @default(UPLOAD)
  sourceReference String?
  languageCode    String             @default("und")
  checksumSha256  String?
  loudnessLufs    Decimal?           @db.Decimal(5, 2)
  durationSeconds Int?
  qcNotes         String?
  submittedById   String?
  reviewedById    String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  promoAsset        PromoAsset           @relation("PromoAssetVersions", fields: [promoAssetId], references: [id], onDelete: Cascade)
  mediaAsset        MediaAsset           @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  submittedBy       User?                @relation("PromoVersionSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy        User?                @relation("PromoVersionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedForPromo  PromoAsset?          @relation("CurrentApprovedPromoVersion")
  processingJobs    PromoProcessingJob[]
  campaigns         Campaign[]
  playoutIntents    PlayoutIntent[]
  proofOfPlayEvents ProofOfPlayEvent[]

  @@unique([promoAssetId, version])
  @@index([promoAssetId, status])
  @@index([mediaAssetId])
  @@index([status, qcStatus])
  @@index([submittedById])
  @@index([reviewedById])
}

model PromoProcessingJob {
  id             String                   @id @default(cuid())
  promoVersionId String
  jobType        PromoProcessingJobType
  status         PromoProcessingJobStatus @default(QUEUED)
  attempts       Int                      @default(0)
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  promoVersion PromoVersion @relation(fields: [promoVersionId], references: [id], onDelete: Cascade)

  @@unique([promoVersionId, jobType])
  @@index([status, createdAt])
}

model Campaign {
  id                         String                 @id @default(cuid())
  organisationId             String
  promoVersionId             String
  name                       String
  status                     CampaignStatus         @default(DRAFT)
  priority                   CampaignPriority       @default(NORMAL)
  schedulingMode             CampaignSchedulingMode
  mandatory                  Boolean                @default(false)
  respectOpeningHours        Boolean                @default(true)
  effectiveFrom              DateTime               @db.Date
  effectiveTo                DateTime               @db.Date
  maxPromoMinutesPerHour     Int                    @default(12)
  minSamePromoGapMinutes     Int                    @default(15)
  minAnyPromoGapMinutes      Int                    @default(2)
  publicationRevision        Int                    @default(0)
  publishedConfigurationHash String?
  publishedById              String?
  publishedAt                DateTime?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  organisation      Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  promoVersion      PromoVersion       @relation(fields: [promoVersionId], references: [id], onDelete: Restrict)
  publishedBy       User?              @relation("CampaignPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  targets           CampaignTarget[]
  rule              CampaignRule?
  schedules         CampaignSchedule[]
  playoutIntents    PlayoutIntent[]
  proofOfPlayEvents ProofOfPlayEvent[]

  @@index([organisationId, status])
  @@index([promoVersionId, status])
  @@index([effectiveFrom, effectiveTo])
}

model CampaignTarget {
  id              String             @id @default(cuid())
  campaignId      String
  targetType      CampaignTargetType
  brandId         String?
  locationGroupId String?
  locationId      String?
  zoneId          String?
  createdAt       DateTime           @default(now())

  campaign      Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  brand         Brand?         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  locationGroup LocationGroup? @relation(fields: [locationGroupId], references: [id], onDelete: Cascade)
  location      Location?      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  zone          Zone?          @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([campaignId, targetType, brandId, locationGroupId, locationId, zoneId])
  @@index([campaignId, targetType])
  @@index([brandId])
  @@index([locationGroupId])
  @@index([locationId])
  @@index([zoneId])
}

model CampaignRule {
  id                 String   @id @default(cuid())
  campaignId         String   @unique
  playsPerHour       Int?
  intervalMinutes    Int?
  exactTimeHardStart Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignSchedule {
  id              String             @id @default(cuid())
  campaignId      String
  weekday         Int
  windowMode      CampaignWindowMode
  startMinute     Int?
  endMinute       Int?
  exactMinute     Int?
  playsPerHour    Int?
  intervalMinutes Int?
  createdAt       DateTime           @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, weekday, startMinute])
  @@index([campaignId, weekday, exactMinute])
}

model Track {
  id           String      @id @default(cuid())
  mediaAssetId String      @unique
  title        String
  artist       String
  album        String?
  releaseYear  Int?
  isExplicit   Boolean     @default(false)
  status       TrackStatus @default(DRAFT)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  mediaAsset        MediaAsset         @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  musicModes        MusicModeTrack[]
  proofOfPlayEvents ProofOfPlayEvent[]

  @@index([status])
  @@index([artist, title])
}

model MusicMode {
  id             String          @id @default(cuid())
  organisationId String
  name           String
  slug           String
  description    String?
  status         MusicModeStatus @default(DRAFT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organisation  Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  tracks        MusicModeTrack[]
  scheduleSlots ScheduleSlot[]

  @@unique([organisationId, slug])
  @@index([organisationId, status])
}

model MusicModeTrack {
  musicModeId String
  trackId     String
  weight      Int      @default(100)
  createdAt   DateTime @default(now())

  musicMode MusicMode @relation(fields: [musicModeId], references: [id], onDelete: Cascade)
  track     Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([musicModeId, trackId])
  @@index([trackId])
}

model MusicSchedule {
  id             String              @id @default(cuid())
  organisationId String
  locationId     String?
  zoneId         String?
  name           String
  version        Int                 @default(1)
  status         MusicScheduleStatus @default(DRAFT)
  timezone       String
  effectiveFrom  DateTime?           @db.Date
  effectiveTo    DateTime?           @db.Date
  publishedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  location     Location?      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  zone         Zone?          @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  slots        ScheduleSlot[]

  @@index([organisationId, status])
  @@index([locationId, status, version])
  @@index([zoneId, status, version])
}

model ScheduleSlot {
  id          String   @id @default(cuid())
  scheduleId  String
  musicModeId String
  weekday     Int
  startMinute Int
  endMinute   Int
  priority    Int      @default(0)
  createdAt   DateTime @default(now())

  schedule  MusicSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  musicMode MusicMode     @relation(fields: [musicModeId], references: [id], onDelete: Restrict)

  @@index([scheduleId, weekday, startMinute])
  @@index([musicModeId])
}

model MediaGenre {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mediaAssets MediaAssetGenre[]
}

model MediaAssetGenre {
  mediaAssetId String
  mediaGenreId String
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  mediaGenre MediaGenre @relation(fields: [mediaGenreId], references: [id], onDelete: Cascade)

  @@id([mediaAssetId, mediaGenreId])
  @@index([mediaGenreId])
  @@index([mediaAssetId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organisationId String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  details        Json?
  createdAt      DateTime @default(now())

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([actorUserId])
}

model Session {
  id                   String   @id @default(cuid())
  userId               String
  activeOrganisationId String?
  tokenHash            String   @unique
  expiresAt            DateTime
  createdAt            DateTime @default(now())

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganisation Organisation? @relation(fields: [activeOrganisationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeOrganisationId])
  @@index([expiresAt])
}

model RateLimitBucket {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

model Player {
  id                 String       @id @default(cuid())
  organisationId     String
  zoneId             String
  name               String
  status             PlayerStatus @default(PENDING_ENROLMENT)
  enrolmentTokenHash String?      @unique
  enrolmentExpiresAt DateTime?
  sessionTokenHash   String?      @unique
  enrolledAt         DateTime?
  lastHeartbeatAt    DateTime?
  lastIpAddress      String?
  lastUserAgent      String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organisation      Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  zone              Zone               @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  proofOfPlayEvents ProofOfPlayEvent[]
  playoutIntents    PlayoutIntent[]

  @@index([organisationId])
  @@index([zoneId])
  @@index([organisationId, status])
  @@index([lastHeartbeatAt])
}

model PlayoutIntent {
  id                  String   @id @default(cuid())
  scheduleItemId      String   @unique
  organisationId      String
  playerId            String
  zoneId              String
  channelId           String?
  campaignId          String
  promoVersionId      String
  mediaAssetId        String
  locationId          String
  locationName        String
  locationTimezone    String
  locationGroups      Json
  publicationRevision Int
  sourceRevision      String
  plannedStart        DateTime
  expiresAt           DateTime
  createdAt           DateTime @default(now())

  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  player         Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  zone           Zone               @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  channel        Channel?           @relation(fields: [channelId], references: [id], onDelete: SetNull)
  campaign       Campaign           @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  promoVersion   PromoVersion       @relation(fields: [promoVersionId], references: [id], onDelete: Restrict)
  mediaAsset     MediaAsset         @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  playbackEvents ProofOfPlayEvent[]

  @@unique([playerId, campaignId, publicationRevision, plannedStart])
  @@index([organisationId, plannedStart])
  @@index([playerId, plannedStart])
  @@index([zoneId, plannedStart])
  @@index([channelId, plannedStart])
  @@index([campaignId, plannedStart])
  @@index([promoVersionId, plannedStart])
  @@index([locationId, plannedStart])
  @@index([expiresAt])
}

model ProofOfPlayEvent {
  id              String               @id @default(cuid())
  clientEventId   String
  organisationId  String
  playerId        String
  zoneId          String
  scheduleItemId  String
  itemType        PlaybackItemType     @default(MUSIC)
  trackId         String?
  campaignId      String?
  promoVersionId  String?
  playoutIntentId String?
  channelId       String?
  mediaAssetId    String
  manifestVersion String
  eventType       ProofOfPlayEventType
  occurredAt      DateTime
  receivedAt      DateTime             @default(now())
  positionSeconds Int?
  failureReason   String?
  playerName      String
  locationName    String
  zoneName        String
  trackTitle      String
  trackArtist     String

  organisation  Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  player        Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  zone          Zone           @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  track         Track?         @relation(fields: [trackId], references: [id], onDelete: Restrict)
  campaign      Campaign?      @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  promoVersion  PromoVersion?  @relation(fields: [promoVersionId], references: [id], onDelete: Restrict)
  playoutIntent PlayoutIntent? @relation(fields: [playoutIntentId], references: [id], onDelete: Restrict)
  channel       Channel?       @relation(fields: [channelId], references: [id], onDelete: SetNull)
  mediaAsset    MediaAsset     @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([clientEventId])
  @@index([organisationId, occurredAt])
  @@index([playerId, occurredAt])
  @@index([scheduleItemId])
  @@index([trackId, occurredAt])
  @@index([campaignId, occurredAt])
  @@index([promoVersionId, occurredAt])
  @@index([playoutIntentId, occurredAt])
  @@index([channelId, occurredAt])
  @@index([manifestVersion])
  @@index([eventType, occurredAt])
}

model ReportExportJob {
  id                String             @id @default(cuid())
  organisationId    String
  requestedByUserId String
  status            ReportExportStatus @default(QUEUED)
  reportType        String             @default("CAMPAIGN_PROOF_CSV")
  filters           Json
  csvContent        String?            @db.Text
  contentSha256     String?
  rowCount          Int                @default(0)
  attempts          Int                @default(0)
  availableAt       DateTime           @default(now())
  leaseUntil        DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  expiresAt         DateTime
  errorMessage      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("ReportExportRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([organisationId, createdAt])
  @@index([requestedByUserId, createdAt])
  @@index([status, availableAt, leaseUntil])
  @@index([expiresAt])
}

