  organisationId   String
  policyId         String
  acceptedByUserId String
  acceptedAt       DateTime @default(now())
  evidence         Json?

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  policy       CompliancePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  acceptedBy   User             @relation("PolicyAcceptanceAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@unique([organisationId, policyId, acceptedByUserId])
  @@index([organisationId, acceptedAt])
  @@index([policyId])
}

model DataRequest {
  id                String            @id @default(cuid())
  organisationId    String
  requestedByUserId String
  subjectUserId     String?
  subjectEmail      String?
  type              DataRequestType
  status            DataRequestStatus @default(OPEN)
  reference         String            @unique
  notes             String?           @db.Text
  dueAt             DateTime
  completedByUserId String?
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("DataRequestRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  subjectUser  User?        @relation("DataRequestSubjectUser", fields: [subjectUserId], references: [id], onDelete: SetNull)
  completedBy  User?        @relation("DataRequestCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, status, dueAt])
  @@index([subjectUserId])
}

model RetentionPolicy {
  id                  String    @id @default(cuid())
  organisationId      String    @unique
  rawPlaybackDays     Int       @default(395)
  playerHeartbeatDays Int       @default(90)
  audioProjectDays    Int       @default(730)
  supportTicketDays   Int       @default(730)
  auditDays           Int       @default(2555)
  reviewedByUserId    String?
  reviewedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("RetentionPolicyReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
}

model RetentionJob {
  id                String             @id @default(cuid())
  organisationId    String
  requestedByUserId String
  status            RetentionJobStatus @default(QUEUED)
  dryRun            Boolean            @default(true)
  policySnapshot    Json
  cutoffs           Json
  candidateCounts   Json?
  errorMessage      String?
  completedAt       DateTime?
  createdAt         DateTime           @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("RetentionJobRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([organisationId, createdAt])
  @@index([status, createdAt])
}

model SupportTicket {
  id                String                @id @default(cuid())
  organisationId    String?
  createdByUserId   String
  assignedToUserId  String?
  priority          SupportTicketPriority @default(NORMAL)
  status            SupportTicketStatus   @default(OPEN)
  reference         String                @unique
  subject           String
  description       String                @db.Text
  linkedEntityType  String?
  linkedEntityId    String?
  incidentStartedAt DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  createdBy    User          @relation("SupportTicketCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignedTo   User?         @relation("SupportTicketAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, status, createdAt])
  @@index([assignedToUserId, status])
  @@index([linkedEntityType, linkedEntityId])
}

model AuditExportSeal {
  id               String   @id @default(cuid())
  sequence         Int      @unique @default(autoincrement())
  organisationId   String
  exportJobId      String   @unique
  previousSealHash String?
  contentSha256    String
  sealHash         String   @unique
  rowCount         Int
  fromAt           DateTime
  untilAt          DateTime
  createdAt        DateTime @default(now())

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  exportJob    ReportExportJob @relation(fields: [exportJobId], references: [id], onDelete: Restrict)

  @@index([organisationId, sequence])
  @@index([organisationId, createdAt])
}

model AnalyticsHourlyAggregate {
  id                       String    @id @default(cuid())
  organisationId           String
  playerId                 String
  playerName               String
  locationId               String
  locationName             String
  zoneId                   String
  zoneName                 String
  bucketStart              DateTime
  plannedCount             Int       @default(0)
  campaignPlannedCount     Int       @default(0)
  schoolPlannedCount       Int       @default(0)
  playbackStartedCount     Int       @default(0)
  playbackCompletedCount   Int       @default(0)
  playbackFailedCount      Int       @default(0)
  playbackInterruptedCount Int       @default(0)
  musicCompletedCount      Int       @default(0)
  promoCompletedCount      Int       @default(0)
  schoolCompletedCount     Int       @default(0)
  heartbeatCount           Int       @default(0)
  firstHeartbeatAt         DateTime?
  lastHeartbeatAt          DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, playerId, bucketStart])
  @@index([organisationId, bucketStart])
  @@index([organisationId, locationId, bucketStart])
  @@index([organisationId, zoneId, bucketStart])
}

model AnalyticsAggregationCursor {
  organisationId      String    @id
  lastIntentCreatedAt DateTime?
  lastIntentId        String?
  lastProofReceivedAt DateTime?
  lastProofEventId    String?
  updatedAt           DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

