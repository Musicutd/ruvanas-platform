FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates liquidsoap \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci

COPY lib ./lib
COPY scripts/online-radio-encoder-worker.mjs scripts/check-online-radio-liquidsoap.mjs ./scripts/
RUN node scripts/check-online-radio-liquidsoap.mjs

USER node
CMD ["node", "scripts/online-radio-encoder-worker.mjs"]
