# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ruvanas"

# Authentication: generate at least 32 random characters.
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Public HTTPS origin used to create private account-recovery links.
RUVANAS_PUBLIC_URL="http://localhost:3000"

# AES-256-GCM key: exactly 64 hexadecimal characters (32 bytes).
SECRET_ENCRYPTION_KEY="replace-with-64-hex-characters"

# Provider-neutral billing webhooks: use at least 32 random characters.
BILLING_WEBHOOK_SECRET="replace-with-at-least-32-random-characters"

# Optional comma-separated browser origins in addition to the deployed site origin.
# Example: ALLOWED_ORIGINS="https://staging.example.com,https://app.example.com"
ALLOWED_ORIGINS=""

# Optional operational labels. Managed hosts can supply their own service name
# and commit identifier automatically when these are left blank.
RUVANAS_ENVIRONMENT=""
RUVANAS_RELEASE_VERSION=""

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"

# Optional Stage 14D isolated protected-media backup. The destination must be
# a separate private bucket. No backup runs merely by setting these values.
R2_BACKUP_BUCKET_NAME=""
R2_BACKUP_PREFIX="ruvanas-backups"
R2_RESTORE_DRILL_PREFIX="ruvanas-restore-drills"

# Centova Cast
CENTOVA_API_URL="https://streaming-host.example.com:2199/api.php"
CENTOVA_API_USERNAME=""
CENTOVA_API_PASSWORD=""

# Optional provider-neutral notification email adapter. All three values are
# required before users can opt in. The endpoint must be public HTTPS and accept
# a JSON body containing from, to, subject, text, and idempotencyKey.
NOTIFICATION_EMAIL_ENDPOINT=""
NOTIFICATION_EMAIL_TOKEN=""
NOTIFICATION_EMAIL_FROM=""

# Optional secondary adapter. It is used only when failover cannot create a
# duplicate: primary DNS failure or an explicit HTTP 502, 503, or 504 response.
# Ambiguous timeouts and connection failures stay on the primary retry path.
NOTIFICATION_EMAIL_FAILOVER_ENDPOINT=""
NOTIFICATION_EMAIL_FAILOVER_TOKEN=""
NOTIFICATION_EMAIL_FAILOVER_FROM=""

# Optional Stage 19.10 provider-neutral Browser Live Studio allocator. Both
# values are required before a presenter can publish. The HTTPS endpoint must
# implement the documented Ruvanas WHIP allocation contract; its access token
# is used only by the server and is never exposed to subscribers.
BROWSER_LIVE_PROVIDER_API_URL=""
BROWSER_LIVE_PROVIDER_API_TOKEN=""

# Promo Only testing integration. OFF by default. PRODUCTION is locked in code.
# Start with DISCOVERY; switch to METADATA only with API credentials.
PROMOONLY_ENABLED=false
PROMOONLY_MODE=DISCOVERY
PROMOONLY_RSS_URL="https://example.invalid/promo-only-rss"
PROMOONLY_POLL_MINUTES=30
PROMOONLY_USER_ID=""
PROMOONLY_API_KEY=""
PROMOONLY_API_SECRET=""
PROMOONLY_AUDIO_DOWNLOAD_ENABLED=false
# HTTPS is tried for bare provider hosts. HTTP requires an explicit testing-only
# exception after security review; bearer credentials otherwise travel in cleartext.
PROMOONLY_ALLOW_HTTP_MEDIA_TEST=false
PROMOONLY_DOWNLOAD_ROLE=SUPER_ADMIN
PROMOONLY_MAX_DOWNLOADS_PER_RUN=10
PROMOONLY_AUTO_CREATE_GENRES=true
PROMOONLY_GENRE_REVIEW_REQUIRED=false
PROMOONLY_REQUEST_TIMEOUT_MS=20000
PROMOONLY_RETRY_MAX=3
# Additional exact media hosts supplied by Promo Only, comma-separated, if needed.
PROMOONLY_DOWNLOAD_HOSTS=""

